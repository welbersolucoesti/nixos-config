--- /dev/null
+++ b/panel/noir-desktop-file.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <QDir>
+#include <QFileInfo>
+#include <QRegularExpression>
+
+// Use the active system's desktop entry for applications exported by its profile.
+inline QString noirDesktopFile(const QString &file)
+{
+    static const QRegularExpression storeApplication(
+        QStringLiteral("^/nix/store/[a-z0-9]{32}-([^/]+)/share/applications/(.+[.]desktop)$"));
+    static const QRegularExpression versionStart(QStringLiteral("-[0-9]"));
+    const auto match = storeApplication.match(file);
+    if (!match.hasMatch())
+        return file;
+
+    const QString relative = match.captured(2);
+    if (QDir::cleanPath(relative) != relative || relative.startsWith(QStringLiteral("../")))
+        return file;
+
+    const QString entry = QStringLiteral("/run/current-system/sw/share/applications/") + relative;
+    const auto current = storeApplication.match(QFileInfo(entry).canonicalFilePath());
+    if (!current.hasMatch())
+        return file;
+
+    // A matching desktop ID alone does not identify a package.
+    const QString package = match.captured(1).section(versionStart, 0, 0);
+    const QString currentPackage = current.captured(1).section(versionStart, 0, 0);
+    if (package == currentPackage
+        || (relative == QStringLiteral("code.desktop") && package == QStringLiteral("vscode")
+            && currentPackage == QStringLiteral("noir-lxqt-code-desktop"))
+        || (relative == QStringLiteral("idea.desktop") && package == QStringLiteral("idea.desktop")
+            && currentPackage == QStringLiteral("idea")))
+        return entry;
+    return file;
+}
+
+inline QString noirFavoriteFile(const QString &file)
+{
+    // Resolve legacy store paths before canonicalizing, even after garbage collection.
+    const QString stable = noirDesktopFile(file);
+    if (stable != file)
+        return stable;
+    return noirDesktopFile(QFileInfo(file).canonicalFilePath());
+}
