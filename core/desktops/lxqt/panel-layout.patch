+bool LXQtPanel::eventFilter(QObject *watched, QEvent *event)
+{
+    if (mFitToContent && watched == LXQtPanelWidget && event->type() == QEvent::LayoutRequest)
+    {
+        const QSize contentSize = mLayout->sizeHint();
+        if (contentSize != mLastContentSize)
+        {
+            mLastContentSize = contentSize;
+            QTimer::singleShot(0, this, &LXQtPanel::realign);
+        }
+    }
+    return QWidget::eventFilter(watched, event);
+}
